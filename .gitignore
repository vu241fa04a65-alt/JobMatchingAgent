# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production Build Output
dist/
client/dist/

# Environment Variables & Secrets
.env
.env.local
.env.production
server/.env
server/.env.local

# SQLite Database Files (protect local persistent db from repo commit)
*.db
*.db-journal
server/data/*.db
server/data/*.db-journal

# Logs & Temp Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large reference assets, PDF docs, and raw UI images
*.pdf
original images/
extracted_ui_images/
del logo.png
tcs logo.webp

# User uploads (keep directory with .gitkeep, ignore uploaded binary files)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/company-logos/.gitkeep
