# ================================================================
# JobMatch AI — Production Environment Variables Configuration Template
# ================================================================

# Server Port (Render sets this dynamically)
PORT=5000

# Node Environment ('production' or 'development')
NODE_ENV=production

# JWT Authentication Secret (REQUIRED in production, minimum 32 characters)
JWT_SECRET=paste_a_secure_random_32_character_string_here

# SantraAI Groq AI Integration (Server-side strictly, never exposed to client)
# Obtain your free API key at https://console.groq.com/
GROQ_API_KEY=paste_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Database Configuration (SQLite file location)
DB_PATH=./server/data/jobmatch.db

# Managed PostgreSQL Database URL (Optional, for persistent cloud deployments on Render / Neon / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
ALLOWED_ORIGINS=https://jobmatchingagent.onrender.com,http://localhost:5173
